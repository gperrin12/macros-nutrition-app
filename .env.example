# macros — environment variables (template)
# Copy to .env and fill in real values:  cp .env.example .env

# Required — natural-language → macros lookup (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Required — Neon Postgres connection string, locally and in production.
# Use the pooled connection string from https://console.neon.tech/
DATABASE_URL=

# Required — Auth.js. Generate with: npx auth secret
AUTH_SECRET=

# At least one OAuth provider (callback: /api/auth/callback/{github,google}).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Production only — your deployed origin, e.g. https://your-app.vercel.app
AUTH_URL=

# One-time only — email to assign existing data to (scripts/migrate-multiuser.mjs).
OWNER_EMAIL=

# Optional — only for a future Expo/iOS client pointing at a deployed origin.
NEXT_PUBLIC_API_BASE=
EXPO_PUBLIC_API_BASE=
