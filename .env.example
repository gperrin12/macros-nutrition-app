# macros — environment variables (template)
# Copy to .env and fill in real values:  cp .env.example .env

# Required — natural-language → macros lookup (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Required — Neon Postgres connection string, locally and in production.
# Use the pooled connection string from https://console.neon.tech/
DATABASE_URL=

# Optional — single shared password gate. Unset = open app. Set for public deploys.
APP_PASSWORD=

# Optional — only for a future Expo/iOS client pointing at a deployed origin.
NEXT_PUBLIC_API_BASE=
EXPO_PUBLIC_API_BASE=
